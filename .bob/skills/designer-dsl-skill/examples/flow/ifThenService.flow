service ifThenService (
    input {
        String score;
    }
    output {
        String output;
    }
) {
    IF(score>=90) {
        MAP {
            mapTarget {
                String score;
                String output;
            }
            set output = "Grade: A";
        };
    }ELSEIF(score>=75) {
        MAP {
            mapTarget {
                String score;
                String output;
            }
            set output = "Grade: B";
        };
    }ELSEIF(score>=60) {
        MAP {
            mapTarget {
                String score;
                String output;
            }
            set output = "Grade: C";
        };
    }ELSE {
        MAP {
            mapTarget {
                String score;
                String output;
            }
            set output = "Grade: D";
        };
    };
}
